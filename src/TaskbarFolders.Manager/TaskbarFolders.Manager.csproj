<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TaskbarFolders.Manager</RootNamespace>
    <AssemblyName>TaskbarFolders.Manager</AssemblyName>
    <Description>TaskbarFolders Manager - Main WPF application for creating and managing taskbar groups</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskbarFolders.Core\TaskbarFolders.Core.csproj" />
    <ProjectReference Include="..\TaskbarFolders.Shared\TaskbarFolders.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
  </ItemGroup>

</Project>
